# Copy to backend/.env (gitignored) and fill in. backend/config.py reads it at
# startup; a variable already set in the environment (e.g. on Render) wins.
# On Render, set these in the service's Environment settings instead: the
# .env file is never committed or deployed.

# ── AI narrative on the Pre-Prediction page (Google Gemini) ───────────────
# API key from Google AI Studio. Server-side only: sent in a request header
# and never reaches the browser. Leave blank to hide the narrative (the page
# says it is not configured).
GEMINI_API_KEY=
# Optional: which Gemini model to call.
GEMINI_MODEL=gemini-2.5-flash
