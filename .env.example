# Backend
DISASTERIQ_ENV=development
LOG_LEVEL=INFO
# Comma-separated list. Use explicit origins: a wildcard disables credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
DB_PATH=backend/data/disaster.db
MODEL_PATH=backend/model/disaster_model.joblib
RULES_PATH=backend/data/recommendation_rules.yaml
# Train a model automatically when the bundle is missing or incompatible.
AUTO_TRAIN=true
WARM_CACHE=true
PREDICT_RATE_LIMIT=60/minute
BATCH_RATE_LIMIT=10/minute
BATCH_MAX_MESSAGES=500
BATCH_MAX_BYTES=4194304
HAZARDS_ENABLED=true
HAZARDS_TTL_SECONDS=600
HAZARDS_TIMEOUT_SECONDS=6
TRANSLATION_ENABLED=true

# Frontend (build-time)
VITE_API_URL=http://localhost:8000
