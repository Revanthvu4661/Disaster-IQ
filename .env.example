# Backend
DISASTERIQ_ENV=development
LOG_LEVEL=INFO
# Comma-separated list. Use explicit origins: a wildcard disables credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
# SQLite store built by `python -m backend.data_pipeline` (or at startup from backend/data/clean/).
DB_PATH=backend/data/disasters.db
WARM_CACHE=true
# Live feeds (USGS, GDACS, NASA EONET)
HAZARDS_ENABLED=true
LIVE_TTL_SECONDS=600
LIVE_TIMEOUT_SECONDS=12
LIVE_PREFETCH=true

# Frontend (build-time)
VITE_API_URL=http://localhost:8000
# Basemap tiles (frontend, build-time; restart `npm run dev` after changing).
# First match wins: MapTiler key, then CARTO key, else keyless Esri Gray Canvas.
# CARTO has required a free key since 23 Sep 2026: https://carto.com/basemaps/apikey
VITE_MAPTILER_KEY=
VITE_MAPTILER_STYLE_LIGHT=streets-v2
VITE_MAPTILER_STYLE_DARK=streets-v2-dark
VITE_CARTO_KEY=
